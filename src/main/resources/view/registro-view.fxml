<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="main.java.com.ingsoft.vitaligold.controller.RegistroController"
           styleClass="root-background"
           stylesheets="@/main/resources/css/registro-view.css">

    <VBox alignment="CENTER" spacing="14" maxWidth="380" styleClass="card">
        <padding>
            <Insets top="36" right="36" bottom="36" left="36" />
        </padding>

        <Label text="Crear cuenta" styleClass="titulo" />
        <Label text="Completa tus datos para registrarte" styleClass="subtitulo" />

        <VBox spacing="6" styleClass="campo">
            <Label text="Nombre completo" styleClass="etiqueta-campo" />
            <TextField fx:id="txtFieldNombre" promptText="Ej. Juan Ignacio" />
        </VBox>

        <VBox spacing="6" styleClass="campo">
            <Label text="Usuario" styleClass="etiqueta-campo" />
            <TextField fx:id="txtFieldUsuario" promptText="Ej. juan.ignacio" />
        </VBox>

        <VBox spacing="6" styleClass="campo">
            <Label text="Contraseña" styleClass="etiqueta-campo" />
            <PasswordField fx:id="txtFieldPassword" promptText="••••••••" />
        </VBox>

        <VBox spacing="6" styleClass="campo">
            <Label text="Correo electrónico" styleClass="etiqueta-campo" />
            <TextField fx:id="txtFieldEmail" promptText="usuario@vitaligold.org" />
        </VBox>

        <Label fx:id="lblMensajeError" styleClass="mensaje-error" wrapText="true" />

        <HBox spacing="12" alignment="CENTER">
            <Button text="Cancelar" onAction="#handleCancelar" styleClass="boton-secundario" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            <Button text="Guardar" onAction="#handleGuardar" styleClass="boton-primario" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>
</StackPane>
